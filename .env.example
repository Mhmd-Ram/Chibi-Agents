# Copy this file to `.env` (same directory) and fill in your values.
# `.env` is gitignored — never commit it.

# Required for AI-generated speech bubbles. Get a key at:
#   https://console.anthropic.com/  →  Settings  →  API Keys
ANTHROPIC_API_KEY=

# Optional: override the daemon HTTP port (default 47821).
# CHIBI_PORT=47821

# Optional: override the Haiku model used for AI speech.
# CHIBI_AI_MODEL=claude-haiku-4-5

# Optional: how long the chibi state persists with no events (seconds).
# CHIBI_DECAY=86400

# Optional: hook → daemon HTTP timeout (seconds).
# CHIBI_HOOK_TIMEOUT=0.2
